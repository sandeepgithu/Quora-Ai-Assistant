def set_timer():
    """Set a timer"""
    try:
        speak("How many seconds?")
        seconds = listen()
        
        if seconds:
            # Extract numbers
            numbers = re.findall(r'\d+', seconds)
            if numbers:
                seconds = int(numbers[0])
                speak(f"Timer set for {seconds} seconds")
                
                for i in range(seconds, 0, -1):
                    if i <= 5:
                        speak(f"{i}")
                    time.sleep(1)
                
                speak("Time's up!")
                # Beep sound
                for _ in range(3):
                    if Config.IS_MAC:
                        os.system('afplay /System/Library/Sounds/Ping.aiff')
                    elif Config.IS_WINDOWS:
                        import winsound
                        winsound.Beep(1000, 500)
                    time.sleep(0.5)
            else:
                speak("I didn't hear a number.")
        else:
            speak("No time specified.")
            
    except Exception as e:
        speak(f"Timer error: {str(e)}")

