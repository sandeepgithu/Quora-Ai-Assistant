def process_command(command):
    """Process voice commands"""
    if not command:
        return
    
    command = command.lower()
    
    # Exit commands
    exit_commands = ['exit', 'quit', 'goodbye', 'bye', 'shutdown', 'stop', 'close', 'terminate']
    if any(cmd in command for cmd in exit_commands):
        speak("Goodbye! Have a great day!")
        return 'exit'
    
    # Greetings
    greetings = ['hello', 'hi', 'hey', 'good morning', 'good afternoon', 'good evening']
    if any(greet in command for greet in greetings):
        responses = [
            "Hello! How can I help you today?",
            "Hi there! What can I do for you?",
            "Hey! Ready to assist!",
            "Greetings! How may I assist you?"
        ]
        speak(random.choice(responses))
        return
    
    # Thanks
    if 'thank you' in command or 'thanks' in command:
        responses = [
            "You're welcome!",
            "Happy to help!",
            "Anytime!",
            "My pleasure!"
        ]
        speak(random.choice(responses))
        return
    
    # How are you
    if 'how are you' in command:
        responses = [
            "I'm doing great! Ready to help!",
            "I'm functioning optimally! How can I assist you?",
            "All systems are go! What can I do for you?"
        ]
        speak(random.choice(responses))
        return
    
    # Name
    if 'your name' in command:
        speak("I'm Quorra, your AI assistant!")
        return
    
    # Creator
    if 'who made you' in command or 'who created you' in command:
        speak("I was created by my developer to assist with various tasks.")
        return
    
    # What can you do
    if 'what can you do' in command or 'help' in command:
        speak("""
        I can help you with many things:
        - Open websites and applications
        - Control your system (lock, sleep, battery)
        - File operations (create, list files)
        - Search the web
        - Get weather information
        - Play music and tell jokes
        - Set timers and alarms
        - Take screenshots
        - Check internet speed
        - Perform calculations
        - And much more!
        Just tell me what you need!
        """)
        return
    
    # Reset chat
    if 'reset chat' in command:
        global chat_history
        chat_history = ""
        speak("Chat history cleared!")
        return
    
    # ============================
    # COMMAND CATEGORIES
    # ============================
    
    # System commands
    if 'system info' in command or 'system information' in command:
        system_info()
    elif 'battery' in command:
        battery_check()
    elif 'clean' in command and ('temp' in command or 'files' in command):
        clean_temp_files()
    elif 'lock' in command and ('screen' in command or 'computer' in command):
        lock_system()
    elif 'sleep' in command or 'sleep mode' in command:
        sleep_mode()
    
    # File operations
    elif 'create file' in command or 'new file' in command:
        create_new_file()
    elif 'list files' in command or 'show files' in command:
        list_directory()
    
    # Web operations
    elif 'open' in command:
        if not open_website(command):
            speak("I couldn't find that website. Would you like me to search for it?")
    elif 'search' in command:
        search_web(command)
    elif 'weather' in command:
        get_weather()
    elif 'internet speed' in command or 'speed test' in command:
        check_internet_speed()
    elif 'ip address' in command or 'my ip' in command:
        get_ip_address()
    
    # Media & entertainment
    elif 'play music' in command:
        play_music()
    elif 'tell me a joke' in command or 'joke' in command:
        tell_joke()
    elif 'youtube' in command and 'play' in command:
        play_youtube(command.replace('play', '').replace('youtube', '').strip())
    elif 'youtube' in command:
        webbrowser.open('https://youtube.com')
        speak("Opening YouTube")
    
    # Productivity
    elif 'timer' in command:
        set_timer()
    elif 'alarm' in command:
        set_alarm()
    elif 'calculate' in command or 'what is' in command and any(op in command for op in ['plus', 'minus', 'times', 'multiplied', 'divided', 'square root']):
        calculate()
    elif 'screenshot' in command:
        take_screenshot()
    elif 'time' in command and ('what' in command or 'tell' in command):
        get_time()
    elif 'date' in command or 'today' in command:
        get_date()
    
    # AI chat
    elif 'using artificial intelligence' in command:
        execute_ai_task(command)
    
    # Application control
    elif 'open' in command:
        # Check for application names
        for app in ['calculator', 'notepad', 'terminal', 'vscode', 'chrome', 'firefox', 'safari', 'spotify', 'vlc']:
            if app in command:
                open_application(app)
                break
    
    # Default to AI chat for everything else
    else:
        ai_chat(command)

