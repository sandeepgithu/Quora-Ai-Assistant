def battery_check():
    """Check battery status"""
    try:
        if Config.IS_MAC:
            result = subprocess.run(['pmset', '-g', 'batt'], capture_output=True, text=True)
            print(result.stdout)
            speak("Battery status displayed.")
        elif Config.IS_WINDOWS:
            import ctypes
            from ctypes import wintypes
            
            class SYSTEM_POWER_STATUS(ctypes.Structure):
                _fields_ = [
                    ('ACLineStatus', wintypes.BYTE),
                    ('BatteryFlag', wintypes.BYTE),
                    ('BatteryLifePercent', wintypes.BYTE),
                ]
            
            GetSystemPowerStatus = ctypes.windll.kernel32.GetSystemPowerStatus
            status = SYSTEM_POWER_STATUS()
            GetSystemPowerStatus(ctypes.byref(status))
            
            percent = status.BatteryLifePercent
            if percent <= 100:
                speak(f"Battery is at {percent}%")
            else:
                speak("Battery status unknown")
        elif Config.IS_LINUX:
            try:
                with open('/sys/class/power_supply/BAT0/capacity', 'r') as f:
                    percent = f.read().strip()
                speak(f"Battery is at {percent}%")
            except:
                speak("Battery information not available")
    except Exception as e:
        speak(f"Battery check error: {str(e)}")

def clean_temp_files():
    """Clean temporary files"""
    try:
        cleaned = 0
        temp_dirs = []
        
        if Config.IS_WINDOWS:
            temp_dirs = [os.getenv('TEMP'), os.getenv('TMP'), r'C:\Windows\Temp']
        elif Config.IS_MAC:
            temp_dirs = ['/tmp', os.path.expanduser('~/Library/Caches')]
        elif Config.IS_LINUX:
            temp_dirs = ['/tmp', '/var/tmp']
        
        for temp_dir in temp_dirs:
            if temp_dir and os.path.exists(temp_dir):
                for root, dirs, files in os.walk(temp_dir):
                    for file in files:
                        try:
                            filepath = os.path.join(root, file)
                            if filepath.endswith('.tmp') or filepath.endswith('.log'):
                                os.remove(filepath)
                                cleaned += 1
                        except:
                            pass
        
        speak(f"Cleaned {cleaned} temporary files.")
    except Exception as e:
        speak(f"Cleanup error: {str(e)}")

