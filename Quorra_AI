def speak(text, speed=180):
    """Text to speech with cross-platform support"""
    try:
        if Config.IS_MAC:
            os.system(f'say -r {speed} "{text}"')
        elif Config.IS_WINDOWS:
            if not hasattr(Config, 'tts_engine'):
                Config.tts_engine = pyttsx3.init()
                voices = Config.tts_engine.getProperty('voices')
                Config.tts_engine.setProperty('voice', voices[0].id)
                Config.tts_engine.setProperty('rate', speed)
            Config.tts_engine.say(text)
            Config.tts_engine.runAndWait()
        elif Config.IS_LINUX:
            os.system(f'espeak "{text}" -s {speed}')
        else:
            print(f"Assistant: {text}")
    except Exception as e:
        print(f"Speech Error: {e}")
        print(f"Assistant: {text}")

def listen():
    """Listen for voice commands"""
    recognizer = sr.Recognizer()
    with sr.Microphone() as source:
        print("🎤 Listening...")
        recognizer.adjust_for_ambient_noise(source, duration=0.5)
        
        try:
            audio = recognizer.listen(source, timeout=5, phrase_time_limit=8)
            command = recognizer.recognize_google(audio, language="en-in")
            print(f"👤 You said: {command}")
            return command.lower()
        except sr.WaitTimeoutError:
            return ""
        except sr.UnknownValueError:
            speak("Sorry, I didn't catch that. Could you please repeat?")
            return ""
        except sr.RequestError:
            speak("Speech service unavailable. Check your internet connection.")
            return ""
        except Exception as e:
            print(f"Recognition error: {e}")
            return ""

def ai_chat(query):
    """Chat with AI"""
    global chat_history
    chat_history += f"User: {query}\nAssistant: "
    
    try:
        response = openai.Completion.create(
            model="text-davinci-003",
            prompt=chat_history,
            temperature=0.7,
            max_tokens=300,
            top_p=1,
            frequency_penalty=0,
            presence_penalty=0
        )
        reply = response["choices"][0]["text"].strip()
        speak(reply)
        chat_history += f"{reply}\n"
        
        # Keep last 10 exchanges
        lines = chat_history.split('\n')
        if len(lines) > 20:
            chat_history = '\n'.join(lines[-20:])
            
        return reply
    except Exception as e:
        speak("Sorry, I couldn't process that request.")
        return str(e)

def execute_ai_task(prompt):
    """Execute AI task and save response"""
    try:
        response = openai.Completion.create(
            model="text-davinci-003",
            prompt=prompt,
            temperature=0.7,
            max_tokens=500,
            top_p=1,
            frequency_penalty=0,
            presence_penalty=0
        )
        result = response["choices"][0]["text"].strip()
        
        # Save to file
        if not os.path.exists("AI_Responses"):
            os.mkdir("AI_Responses")
        
        filename = f"AI_Responses/{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        with open(filename, 'w') as f:
            f.write(f"Prompt: {prompt}\n\nResponse:\n{result}")
        
        speak("AI task completed and saved.")
        return result
    except Exception as e:
        speak("AI service error.")
        return str(e)

