def main():
    """Main function to run the assistant"""
    print("🚀" + "="*60)
    print("🤖 QUORRA - AI VOICE ASSISTANT")
    print("="*60 + "🚀")
    print(f"System: {platform.system()} {platform.release()}")
    print(f"Python: {platform.python_version()}")
    print(f"User: {getpass.getuser()}")
    print("="*60)
    
    # Initial greeting
    greetings = [
        "Hello! I'm Quorra, your AI assistant.",
        "Hi there! I'm Quorra, ready to help!",
        "Greetings! I'm Quorra. How can I assist you today?",
        "Hello! Quorra here. What can I do for you?"
    ]
    speak(random.choice(greetings))
    
    # Main loop
    while True:
        try:
            print("\n" + "─"*60)
            print("💬 Say something or 'exit' to quit:")
            
            command = listen()
            
            if command:
                result = process_command(command)
                if result == 'exit':
                    break
                
            time.sleep(0.5)
            
        except KeyboardInterrupt:
            print("\n\n🛑 Interrupted by user")
            speak("Goodbye!")
            break
        except Exception as e:
            print(f"❌ Error: {e}")
            speak("Sorry, I encountered an error. Let's try again.")
            time.sleep(1)

