def get_weather(city=None):
    """Get weather information"""
    try:
        if not Config.WEATHER_API_KEY or Config.WEATHER_API_KEY == "your-weather-api-key":
            speak("Weather API not configured. Please add your API key.")
            return
        
        if not city:
            speak("Which city?")
            city = listen()
            if not city:
                city = "New York"
        
        url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={Config.WEATHER_API_KEY}&units=metric"
        response = requests.get(url)
        data = response.json()
        
        if data.get("cod") == 200:
            temp = data["main"]["temp"]
            humidity = data["main"]["humidity"]
            description = data["weather"][0]["description"]
            wind = data["wind"]["speed"]
            
            speak(f"Weather in {city}:")
            speak(f"Temperature: {temp}°C")
            speak(f"Conditions: {description}")
            speak(f"Humidity: {humidity}%")
            speak(f"Wind speed: {wind} m/s")
        else:
            speak(f"Could not find weather for {city}")
            
    except Exception as e:
        speak(f"Weather error: {str(e)}")

