def create_new_file():
    """Create a new file"""
    try:
        speak("What should I name the file?")
        filename = listen()
        
        if not filename:
            speak("No filename provided.")
            return
        
        # Clean filename
        filename = ''.join(c for c in filename if c.isalnum() or c in (' ', '-', '_')).strip()
        if not filename:
            filename = "new_file"
        
        speak("What type of file? Say python, text, or html.")
        filetype = listen()
        
        if 'python' in filetype:
            ext = '.py'
            content = '#!/usr/bin/env python3\n\nprint("Hello World!")\n'
        elif 'html' in filetype:
            ext = '.html'
            content = '''<!DOCTYPE html>
<html>
<head>
    <title>New Document</title>
</head>
<body>
    <h1>Welcome</h1>
</body>
</html>'''
        else:
            ext = '.txt'
            content = 'This is a new text file.\n'
        
        if not filename.endswith(ext):
            filename += ext
        
        filepath = os.path.join(Config.DOCUMENTS_PATH, filename)
        
        with open(filepath, 'w') as f:
            f.write(content)
        
        speak(f"Created {filename} in Documents.")
        
        # Open in editor
        if 'code' in filetype:
            if shutil.which('code'):
                subprocess.run(['code', filepath])
            elif shutil.which('subl'):
                subprocess.run(['subl', filepath])
        
    except Exception as e:
        speak(f"File creation error: {str(e)}")

