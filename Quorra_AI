        speak("What time? For example, say 7:30 AM")
        alarm_time = listen()
        
        if alarm_time:
            # Simple time parsing (you can enhance this)
            numbers = re.findall(r'\d+', alarm_time)
            if len(numbers) >= 2:
                hour = int(numbers[0])
                minute = int(numbers[1])
                
                # Determine AM/PM
                if 'pm' in alarm_time.lower() and hour < 12:
                    hour += 12
                elif 'am' in alarm_time.lower() and hour == 12:
                    hour = 0
                
                current = datetime.datetime.now()
                alarm = current.replace(hour=hour, minute=minute, second=0)
                
                if alarm < current:
                    alarm += datetime.timedelta(days=1)
                
                wait_seconds = (alarm - current).seconds
                speak(f"Alarm set for {hour:02d}:{minute:02d}")
                
                time.sleep(wait_seconds)
                
                speak("Wake up! Alarm time!")
                for _ in range(5):
                    if Config.IS_MAC:
                        os.system('afplay /System/Library/Sounds/Submarine.aiff')
                    elif Config.IS_WINDOWS:
                        import winsound
                        winsound.Beep(2000, 1000)
                    time.sleep(1)
            else:
                speak("Please specify time properly.")
        else:
            speak("No time specified.")
            
    except Exception as e:
        speak(f"Alarm error: {str(e)}")

def calculate():
    """Perform calculations"""
    try:
        speak("What should I calculate?")
        expression = listen()
        
        if expression:
            # Remove words and keep math
            expression = expression.replace('calculate', '').replace('what is', '').strip()
            
            # Handle special cases
            if 'square root of' in expression:
                num = float(expression.replace('square root of', '').strip())
                result = math.sqrt(num)
            elif 'power' in expression or '^' in expression:
                expression = expression.replace('power', '**').replace('^', '**')
                result = eval(expression)
            else:
                # Basic safety check
                allowed_chars = '0123456789+-*/(). '
                if all(c in allowed_chars for c in expression):
                    result = eval(expression)
                else:
                    speak("Invalid expression.")
                    return
            
            speak(f"The result is {result}")
            print(f"Calculation: {expression} = {result}")
        else:
            speak("No expression provided.")
            
    except Exception as e:
        speak(f"Calculation error: {str(e)}")

def take_screenshot():
    """Take screenshot"""
    try:
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"screenshot_{timestamp}.png"
        filepath = os.path.join(Config.DESKTOP_PATH, filename)
        
        screenshot = pyautogui.screenshot()
        screenshot.save(filepath)
        
        speak(f"Screenshot saved as {filename}")
    except Exception as e:
        speak(f"Screenshot error: {str(e)}")

def get_time():
    """Get current time"""
    now = datetime.datetime.now()
    time_str = now.strftime("%I:%M %p")
    speak(f"The time is {time_str}")

def get_date():
    """Get current date"""
    today = datetime.datetime.now()
    date_str = today.strftime("%A, %B %d, %Y")
    speak(f"Today is {date_str}")

